<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="18dp">

    <TextView android:id="@+id/place_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="12dp" />
    <TextView android:id="@+id/question_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textSize="18sp" android:lineSpacingExtra="3dp" android:layout_marginTop="14dp" android:layout_marginBottom="20dp" />

    <Button android:id="@+id/btn_a" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
    <Button android:id="@+id/btn_b" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
    <Button android:id="@+id/btn_c" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
    <Button android:id="@+id/btn_d" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
</LinearLayout>
