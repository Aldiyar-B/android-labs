<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">

    <TextView android:id="@+id/detailName"   android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:id="@+id/detailVendor" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:layout_marginBottom="12dp" />

    <FrameLayout android:id="@+id/charContainer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#E3F2FD" />
    <FrameLayout android:id="@+id/riskContainer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#FFF3E0" android:layout_marginTop="8dp" />

    <Button android:id="@+id/btnOpenSite" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Открыть сайт инструмента" android:layout_marginTop="12dp" />
    <Button android:id="@+id/btnEmail"    android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Отправить рекомендацию" android:layout_marginTop="8dp" />
</LinearLayout>
